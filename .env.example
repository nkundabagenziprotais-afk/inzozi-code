APP_ENV=development
APP_NAME=Inzozi Code
PUBLIC_APP_URL=http://localhost:8080
API_INTERNAL_URL=http://api:8000
POSTGRES_DB=inzozi_code
POSTGRES_USER=inzozi_code
POSTGRES_PASSWORD=change-me-before-deployment
DATABASE_URL=postgresql://inzozi_code:change-me-before-deployment@postgres:5432/inzozi_code
REDIS_URL=redis://redis:6379/0
REDIS_SOCKET_CONNECT_TIMEOUT_SECONDS=1
REDIS_SOCKET_TIMEOUT_SECONDS=1

AQUILA_PROVIDER=openai
AQUILA_MODEL=gpt-5.6
AQUILA_MAX_TURNS=12
OPENAI_DEFAULT_MODEL=gpt-5.6
# OPENAI_API_KEY is intentionally omitted from this tracked example.
# Inject it only as a server-side secret at runtime.

WORKSPACE_SERVICE_URL=http://workspace-manager:8200
WORKSPACE_OWNERSHIP_ENFORCED=false
WORKSPACE_BROKER_URL=http://workspace-broker:8300
# Generate a unique 32+ character value for staging/production; never commit the real value.
WORKSPACE_BROKER_TOKEN=
WORKSPACE_RUNTIME_IMAGE=inzozi-code-workspace-runtime:local
WORKSPACE_QUOTA_HELPER_IMAGE=inzozi-code-workspace-quota-helper:local
# Staging hard quotas require this host path to be an XFS filesystem mounted with prjquota.
WORKSPACE_QUOTA_STORAGE_ROOT=/srv/inzozi-code/workspace-data
# Git helpers use an internal network and a fixed github.com:443-only CONNECT proxy.
WORKSPACE_TTL_SECONDS=28800
WORKSPACE_MAX_ACTIVE=8
WORKSPACE_DISK_LIMIT_BYTES=2147483648
WORKSPACE_MAX_FILE_BYTES=1048576
WORKSPACE_MAX_OUTPUT_BYTES=65536
WORKSPACE_MAX_SEARCH_FILE_BYTES=524288
WORKSPACE_MAX_CHECKPOINT_BYTES=104857600
WORKSPACE_RUNTIME_MEMORY_LIMIT=4g
WORKSPACE_RUNTIME_CPUS=2.0
WORKSPACE_RUNTIME_PIDS_LIMIT=256

# GitHub App private-repository access. Keep the private key out of this file.
GITHUB_APP_ID=
GITHUB_APP_OWNER=nkundabagenziprotais-afk
GITHUB_APP_DEFAULT_INSTALLATION_ID=
GITHUB_APP_PRIVATE_KEY_PATH=

# Staging authentication. Never store a plaintext password here.
AUTH_ENABLED=false
AUTH_BOOTSTRAP_EMAIL=
AUTH_PASSWORD_HASH=
AUTH_SESSION_SECRET=
AUTH_BOOTSTRAP_ROLE=platform_owner
AUTH_ORGANIZATION_ID=inzozi-digital
AUTH_SESSION_TTL_MINUTES=480
# Keep false for the private localhost SSH-tunnel preview. Set true when staging is HTTPS-only.
AUTH_COOKIE_SECURE=false
# Comma-separated trusted reverse-proxy hostnames/IPs/CIDRs allowed to supply X-Real-IP.
# Empty disables forwarding-header trust (peer IP only). Compose defaults to "nginx".
AUTH_TRUSTED_PROXIES=nginx
