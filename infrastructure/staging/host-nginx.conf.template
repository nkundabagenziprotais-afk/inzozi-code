# Per-source request budgets.
#
# Public-edge activation remains blocked until the reviewed edge establishes
# the authenticated real-client-IP boundary. Never trust arbitrary public
# forwarding headers merely to make these keys client-specific.
limit_req_zone $binary_remote_addr zone=inzozi_login_per_ip:10m rate=12r/m;
limit_req_zone $binary_remote_addr zone=inzozi_api_per_ip:10m rate=15r/s;
limit_req_zone $binary_remote_addr zone=inzozi_expensive_per_ip:10m rate=30r/m;
limit_conn_zone $binary_remote_addr zone=inzozi_conn_per_ip:10m;

server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name _;

    return 404;
}

server {
    listen 80;
    listen [::]:80;
    server_name code-staging.inzozidigital.com;

    limit_conn inzozi_conn_per_ip 32;
    limit_conn_status 429;

    location / {
        return 308 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2 default_server;
    listen [::]:443 ssl http2 default_server;
    server_name _;

    ssl_certificate /etc/inzozi-code/tls/code-staging.inzozidigital.com/fullchain.pem;
    ssl_certificate_key /etc/inzozi-code/tls/code-staging.inzozidigital.com/privkey.pem;

    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_tickets off;

    return 404;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name code-staging.inzozidigital.com;

    ssl_certificate /etc/inzozi-code/tls/code-staging.inzozidigital.com/fullchain.pem;
    ssl_certificate_key /etc/inzozi-code/tls/code-staging.inzozidigital.com/privkey.pem;

    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_timeout 1d;
    ssl_session_cache shared:INZOZI_SSL:10m;
    ssl_session_tickets off;

    limit_req_status 429;
    limit_conn_status 429;
    limit_req_log_level warn;
    limit_conn_log_level warn;

    limit_conn inzozi_conn_per_ip 32;

    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;

    # Vite bundles execute from the same origin. Monaco may create blob
    # workers and runtime style elements, so worker-src blob: and
    # style-src 'unsafe-inline' are intentionally narrow compatibility
    # exceptions. Script execution remains self-only with no unsafe-eval.
    add_header Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; form-action 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; worker-src 'self' blob:; child-src 'self' blob:; manifest-src 'self'; upgrade-insecure-requests" always;

    client_max_body_size 20m;

    location = /api/v1/auth/login {
        limit_req zone=inzozi_login_per_ip burst=4 nodelay;
        limit_conn inzozi_conn_per_ip 4;
        client_max_body_size 16k;

        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;

        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";

        proxy_read_timeout 300s;
    }

    location = /api/v1/auth/activate {
        limit_req zone=inzozi_login_per_ip burst=4 nodelay;
        limit_conn inzozi_conn_per_ip 4;
        client_max_body_size 16k;

        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;

        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";

        proxy_read_timeout 300s;
    }

    location = /api/v1/agent/run {
        limit_req zone=inzozi_expensive_per_ip burst=5 nodelay;
        limit_conn inzozi_conn_per_ip 4;
        client_max_body_size 64k;

        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;

        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";

        proxy_read_timeout 300s;
    }

    location ~ "^/api/v1/workspaces/[0-9a-f]{32}/actions$" {
        limit_req zone=inzozi_expensive_per_ip burst=5 nodelay;
        limit_conn inzozi_conn_per_ip 4;
        client_max_body_size 16k;

        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;

        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";

        proxy_read_timeout 300s;
    }

    location /api/ {
        limit_req zone=inzozi_api_per_ip burst=45 nodelay;
        limit_conn inzozi_conn_per_ip 16;

        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;

        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";

        proxy_read_timeout 300s;
    }

    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;

        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";

        proxy_read_timeout 300s;
    }
}
