# Example only. Copy to /srv/inzozi-code/secrets/ops-monitor.env as root
# with mode 0600 when activating the monitor.

# Private-staging acceptance expects no active workspace runtime residue.
EXPECT_ZERO_WORKSPACES=YES

# Five-minute rolling HTTP 5xx threshold.
FIVE_XX_WINDOW_SECONDS=300
FIVE_XX_CRITICAL_THRESHOLD=10
