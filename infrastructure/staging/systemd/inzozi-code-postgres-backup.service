[Unit]
Description=Inzozi Code staging PostgreSQL encrypted off-host backup
Wants=network-online.target docker.service
After=network-online.target docker.service

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
ExecStart=/usr/local/sbin/inzozi-code-postgres-backup
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
TimeoutStartSec=45min
